# Публичный HTTPS-адрес без завершающего слеша.
WORKSPACE_PUBLIC_URL=https://facet.example.com
# Доверять X-Real-IP от Nginx. Порт 8765 должен оставаться привязанным к 127.0.0.1.
WORKSPACE_TRUST_PROXY=1

# SMTP обязателен для регистрации и восстановления пароля на внешнем адресе.
WORKSPACE_SMTP_HOST=smtp.example.com
WORKSPACE_SMTP_PORT=465
WORKSPACE_SMTP_USER=
WORKSPACE_SMTP_PASSWORD=
WORKSPACE_MAIL_FROM=Facet <no-reply@example.com>

# Ключ остаётся только на сервере. Не добавляйте .env.production в Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-5.6-luna
FACET_AI_DAILY_LIMIT=20
